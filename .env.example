# Copy to .env and fill in. .env holds real secrets and is not committed.
# JWT
JWT_SECRET_KEY=<random string, at least 64 characters>
# DB connection
DBMS_CONNECTION=jdbc:mysql://localhost:3306/supermarket_management?useSSL=false&allowPublicKeyRetrieval=true
DBMS_USERNAME=<db user>
DBMS_PASSWORD=<db password>
# Default Admin user info
ADMIN_USERNAME=admin1234
ADMIN_PASSWORD=<strong password>
EMPLOYEE_DEFAULT_PASSWORD=<initial password for new employees>
# URL Client
ORIGIN_CLIENT_1=http://localhost:4200
