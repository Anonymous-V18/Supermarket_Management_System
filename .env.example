# Copy to .env and fill in. .env holds real secrets and is not committed.
# JWT
JWT_SECRET_KEY=<random string, at least 64 characters>
# DB connection
DBMS_CONNECTION=jdbc:mysql://localhost:3306/supermarket_management?useSSL=false&allowPublicKeyRetrieval=true
DBMS_USERNAME=<db user>
DBMS_PASSWORD=<db password>
# Default Admin user info
ADMIN_USERNAME=admin1234
ADMIN_PASSWORD=<strong password>
EMPLOYEE_DEFAULT_PASSWORD=<initial password for new employees>
# URL Client
ORIGIN_CLIENT_1=http://localhost:4200
# Chatbot: Qdrant vector DB (collection is created on startup)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=<optional, set the same value as QDRANT__SERVICE__API_KEY of the qdrant service>
QDRANT_COLLECTION=kb_chunks
# Chatbot: optional embedding service for meaning-based search (blank = keyword search only).
# Base URL without /v1, e.g. http://localhost:8081 (TEI) or http://localhost:11434 (Ollama); model must give 768 dimensions.
# For intfloat/multilingual-e5-base set the prefixes to "query: " and "passage: ".
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
# Chatbot: optional local SLM function calling controller (zero-hardcode router).
# Uses local Ollama instance (e.g. qwen2.5:0.5b). When false or offline, falls back to deterministic rule engine.
SLM_ENABLED=false
SLM_URL=http://localhost:11434
SLM_MODEL=qwen2.5:0.5b
SLM_TIMEOUT_MS=3000
